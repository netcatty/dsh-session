{
  "name": "@netcatty/dsh-session",
  "version": "0.2.2",
  "description": "Session management for DeepSeek Harness: catalog, search, annotations, trash/restore, workspace move, preset migration and export",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/store.js && node --check lib/annotations.js && node --check lib/session-files.js && node --check lib/compat/zstd-frames.js && node -e \"import('./lib/index.js')\"",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.0",
    "node": "^22.15.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "session",
    "workspace",
    "plugin"
  ],
  "author": "netcatty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netcatty/dsh-session.git"
  },
  "homepage": "https://github.com/netcatty/dsh-session#readme",
  "bugs": {
    "url": "https://github.com/netcatty/dsh-session/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
